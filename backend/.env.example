# Copy to backend/.env for local use. Never commit the real file.

# PostgreSQL connection string (Neon, or any PostgreSQL 14+ with the pgcrypto extension)
DATABASE_URL=postgresql://user:password@localhost:5432/valitrack

# Long random string used to sign login cookies
SECRET_KEY=change-me-to-a-long-random-string

# Demo mode shows the demo logins on the login page, shortens the lockout time
# and allows the daily demo reset. Keep it false for anything that is not a demo.
DEMO_MODE=true

# Secret for POST /api/demo/reset (used by the scheduled daily reset)
DEMO_RESET_TOKEN=change-me-too

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
